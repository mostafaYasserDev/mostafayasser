{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mostafayasser",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
